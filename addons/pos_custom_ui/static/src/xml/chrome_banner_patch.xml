<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_ui.ChromeExpirationBanner" t-inherit="point_of_sale.Chrome" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos') and hasclass('dvh-100') and hasclass('d-flex') and hasclass('flex-column')]" position="inside">
            <div
                t-if="this.expirationBannerState.visible"
                class="pos-expiration-banner-overlay pe-none"
                t-att-class="this.expirationBannerState.mode === 'expired' ? 'is-expired' : 'is-warning'"
            >
                <div class="pos-expiration-banner-card">
                    <span class="pos-expiration-banner-message" t-esc="this.expirationBannerState.message"/>
                    <span class="pos-expiration-banner-divider"> | </span>
                    <span class="pos-expiration-banner-deadline" t-esc="this.expirationBannerState.deadlineText"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
